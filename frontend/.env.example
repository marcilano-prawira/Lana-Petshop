# Opsional. Isi hanya jika frontend dan backend berada di alamat berbeda saat production.
# Contoh: VITE_API_URL=https://api.lanapetshop.com/api
VITE_API_URL=/api

# Opsional. Alamat backend untuk proxy saat `npm run dev`.
VITE_BACKEND_URL=http://localhost:3000

# Perkiraan tarif pet hotel per hari (samakan dengan HOTEL_TARIF_PER_HARI di backend).
VITE_HOTEL_TARIF_PER_HARI=75000
